#!/usr/bin/env bash

shutdown_guest() {
  trap - EXIT HUP TERM
  sudo systemctl poweroff --no-block >/dev/null 2>&1 || true
}
trap shutdown_guest EXIT HUP TERM

# SSH may start tmux before the login shell sets a UTF-8 locale.
tmux -u new-session -A -s agent -c /workspace/projects /usr/local/bin/agent-session

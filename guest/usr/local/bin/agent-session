#!/usr/bin/env bash
set -euo pipefail

export PATH="/home/agent/.local/bin:$PATH"

if ! systemctl is-active --quiet prepare-workspace.service || ! mountpoint -q /workspace; then
  printf 'Workspace preparation failed; refusing to start a session.\n' >&2
  exit 1
fi

cd /workspace/projects
clear
printf '\n  Disposable Arch Agent VM\n'
printf '  Persistent workspace: /workspace/projects\n'
printf '  Persistent agent state: /workspace/.agent-state\n\n'
printf '  Start an agent with:  codex --yolo\n'
printf '                        claude --dangerously-skip-permissions\n'
printf '                        opencode\n\n'
exec bash -l

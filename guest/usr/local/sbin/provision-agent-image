#!/usr/bin/env bash
set -euo pipefail

usermod -aG docker agent
# Package upgrades may replace the running kernel's modules. Start Docker
# on the next boot, when the installed kernel and modules match.
systemctl enable docker.service
sudo -u agent docker --version
sudo -u agent docker compose version
sudo -u agent docker-compose version

install -d -o agent -g agent /home/agent /home/agent/.local
install -o agent -g agent -m 0644 /usr/local/share/arch-agent/bash_profile /home/agent/.bash_profile
install -o agent -g agent -m 0644 /usr/local/share/arch-agent/bashrc /home/agent/.bashrc
sudo -u agent env HOME=/home/agent npm config set prefix /home/agent/.local
# Keep Codex binaries on the OS disk: the standalone installer stores them in
# ~/.codex, which workspace preparation replaces with persistent agent state.
sudo -u agent env HOME=/home/agent npm install -g @openai/codex
# Use the existing npm prefix to keep Pi binaries on the disposable OS disk.
sudo -u agent env HOME=/home/agent npm install -g --ignore-scripts @earendil-works/pi-coding-agent
sudo -u agent env HOME=/home/agent curl -fsSL https://claude.ai/install.sh -o /tmp/install-claude.sh
sudo -u agent env HOME=/home/agent bash /tmp/install-claude.sh
rm -f /tmp/install-claude.sh
test -x /home/agent/.local/bin/codex
test -x /home/agent/.local/bin/claude
test -x /usr/bin/opencode
test -x /home/agent/.local/bin/pi
sudo -u agent env HOME=/home/agent /home/agent/.local/bin/codex --version
sudo -u agent env HOME=/home/agent /home/agent/.local/bin/claude --version
sudo -u agent env HOME=/home/agent /usr/bin/opencode --version
sudo -u agent env HOME=/home/agent /home/agent/.local/bin/pi --version
systemctl enable prepare-workspace.service agent-authorized-keys.service
systemctl set-default multi-user.target
touch /etc/cloud/cloud-init.disabled
touch /var/lib/arch-agent-image-ready
printf '%s\n' ARCH_AGENT_IMAGE_READY >/dev/ttyS0

[Unit]
Description=Coding agent tmux session
Requires=prepare-workspace.service
After=prepare-workspace.service network-online.target
Wants=network-online.target

[Service]
Type=forking
User=agent
Environment=TERM=xterm-256color
Environment=SSH_AUTH_SOCK=/home/agent/.ssh/agent.sock
ExecCondition=/usr/local/bin/agent-autostart --check
ExecStart=/usr/local/bin/agent-autostart
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

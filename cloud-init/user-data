#cloud-config
hostname: arch-agent
manage_etc_hosts: true

users:
  - name: agent
    gecos: AI Agent
    groups: [wheel]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - "@@ARCH_AGENT_SSH_PUBLIC_KEY@@"

package_update: true
package_upgrade: true
packages:
  - base-devel
  - bubblewrap
  - cage
  - curl
  - dbus
  - docker
  - docker-compose
  - e2fsprogs
  - fd
  - fzf
  - foot
  - git
  - github-cli
  - go
  - jq
  - less
  - man-db
  - nano
  - neovim
  - nodejs
  - npm
  - openssh
  - polkit
  - ripgrep
  - rsync
  - tmux
  - ttf-dejavu
  - unzip
  - wget

# Files under guest/ (plus config/persist-home.conf), packed by build-image.sh.
write_files:
  - path: /var/lib/arch-agent/guest-files.tar.gz
    permissions: "0600"
    encoding: b64
    content: "@@ARCH_AGENT_GUEST_FILES@@"

runcmd:
  - [tar, -xzf, /var/lib/arch-agent/guest-files.tar.gz, -C, /]
  - [rm, -f, /var/lib/arch-agent/guest-files.tar.gz]
  - [/usr/local/sbin/provision-agent-image]

power_state:
  mode: poweroff
  message: Agent image provisioning complete
  timeout: 30
  condition: [test, -f, /var/lib/arch-agent-image-ready]
